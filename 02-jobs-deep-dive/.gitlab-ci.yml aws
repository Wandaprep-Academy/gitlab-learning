# ============================================================
# 02 — Jobs Deep Dive
# Demonstrates before_script, after_script, rules, needs,
# allow_failure, and the manual deployment gate pattern.
# Runner: Amazon Linux 2023 (Shell Executor)
# ============================================================

stages:
  - build
  - test
  - deploy

default:
  tags:
    - aws
  # before_script at default level runs for EVERY job unless overridden
  before_script:
    - 'echo "=== Job starting on Runner: $CI_RUNNER_DESCRIPTION ==="'
    - 'echo "=== Pipeline: $CI_PIPELINE_ID | Commit: $CI_COMMIT_SHORT_SHA ==="'

# ── STAGE: build ──────────────────────────────────────────
build:
  stage: build
  before_script:           # Overrides the default before_script for this job only
    - echo "Installing build dependencies..."
    - npm ci --silent || echo "(no package.json — skipping)"
  script:
    - echo "Compiling application..."
    - mkdir -p dist
    - 'echo "{ \"version\": \"1.0.0\", \"commit\": \"$CI_COMMIT_SHORT_SHA\" }" > dist/build-info.json'
    - zip -j dist/build-artifact.zip dist/build-info.json
    - echo "Build artifact written to dist/build-artifact.zip"
    - ls -lh dist/
  after_script:            # Runs even if script: fails
    - echo "Build job finished. Cleaning up temp files."
  artifacts:
    paths:
      - dist/
    expire_in: 1 hour

# ── STAGE: test ───────────────────────────────────────────
test-unit:
  stage: test
  needs: [build]           # Run as soon as 'build' passes
  script:
    - echo "Running unit tests..."
    - echo "Checking build artifacts..."
    - ls -lh dist/
    - unzip -l dist/build-artifact.zip
    - unzip -p dist/build-artifact.zip build-info.json
    - echo "All 47 unit tests passed."

test-integration:
  stage: test
  script:
    - echo "Running integration tests (slower)..."
    - sleep 2
    - echo "Integration tests passed."

test-lint:
  stage: test
  allow_failure: true      # Lint issues warn but don't break the pipeline
  script:
    - echo "Running code style checks..."
    - 'echo "Warning: 2 minor style issues found (non-blocking)."'
    - exit 1               # Fails, but allow_failure:true means pipeline continues

# ── STAGE: deploy ─────────────────────────────────────────
deploy-staging:
  stage: deploy
  script:
    - echo "Deploying to STAGING environment..."
    - unzip -p dist/build-artifact.zip build-info.json
  environment:
    name: staging
    url: https://staging.example.com
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'   # Only deploy staging on main branch
    - if: '$CI_MERGE_REQUEST_ID'           # Or on Merge Request pipelines
      when: never

deploy-production:
  stage: deploy
  script:
    - echo "Deploying to PRODUCTION environment..."
    - echo "Deployed $CI_COMMIT_TAG to production."
  environment:
    name: production
    url: https://www.example.com
  rules:
    - if: '$CI_COMMIT_TAG'                 # Only run when a git tag is pushed
      when: manual                         # AND requires a human to click "play"
